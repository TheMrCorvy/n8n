# ============================================================
# n8n – Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# NEVER commit .env to version control.
# ============================================================
#
# Key settings to configure before first run:
#   1. N8N_ENCRYPTION_KEY  – generate with: openssl rand -hex 32
#   2. HOST_LOG_PATH       – host folder where Loki/Promtail reads *.log files
# ============================================================

# ── Network / URL ────────────────────────────────────────────
# Hostname where n8n will be reachable (no protocol, no port).
# Use "localhost" for local development.
N8N_HOST=localhost

# Port exposed on the host machine (default: 5678).
N8N_PORT=5678

# Protocol: "http" for local dev, "https" when behind a reverse proxy.
N8N_PROTOCOL=http

# Maximum payload size in MiB (default: 16). Increase this to allow larger pinned data size.
# 128 = 128 MB (very generous compared to default limit)
N8N_PAYLOAD_SIZE_MAX=128

# Full base URL used for webhooks. Must be reachable from the internet
# if you want external services to trigger webhooks.
# Example for a public domain: https://n8n.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/

# ── Security ─────────────────────────────────────────────────
# REQUIRED: 32-byte hex key used to encrypt stored credentials.
# Generate with:  openssl rand -hex 32
# Once set, DO NOT change this value or all saved credentials will break.
N8N_ENCRYPTION_KEY=

# ── Timezone ─────────────────────────────────────────────────
# Used for scheduling workflows. See https://momentjs.com/timezone/
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# ── Telemetry ────────────────────────────────────────────────
# Set to "false" to opt out of anonymous usage statistics.
N8N_DIAGNOSTICS_ENABLED=false

# Notify when a new n8n version is available.
N8N_VERSION_NOTIFICATIONS_ENABLED=true

# ── Execution data retention ─────────────────────────────────
# Save execution data on error / success / manual runs.
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Automatically prune old execution data.
EXECUTIONS_DATA_PRUNE=true

# Maximum age (in hours) of saved execution data before pruning.
# 336h = 14 days
EXECUTIONS_DATA_MAX_AGE=336

# ── Logging / Loki integration ─────────────────────────────────
# Absolute path on the HOST machine that will be bind-mounted into the
# container. n8n writes rotating .log files here; Loki/Promtail should
# watch this folder for *.log files.
#
# ── macOS Sequoia – Desktop/www example (next test case) ───────────
# Replace "yourusername" with the actual macOS user account name.
#   HOST_LOG_PATH=/Users/yourusername/Desktop/www/logs/n8n
#
# ── Linux home-server example ──────────────────────────────
#   HOST_LOG_PATH=/var/log/n8n
HOST_LOG_PATH=/Users/yourusername/Desktop/www/logs/n8n

# Log destination: "file" writes rotating files to HOST_LOG_PATH.
# Use "console,file" if you also want stdout (e.g. docker logs output).
N8N_LOG_OUTPUT=file

# Log verbosity: error | warn | info | verbose | debug
N8N_LOG_LEVEL=info

# Number of rotated log files to keep before the oldest is deleted.
N8N_LOG_FILE_COUNT=30

# ── Music downloads ───────────────────────────────────────────────────────────
# Absolute path on the HOST machine where yt-dlp / spotdl will save downloaded
# tracks. Point this at the same folder Navidrome (shockwave) uses as its
# MUSIC_PATH so new downloads are picked up by the library scanner automatically.
#
# REQUIRED: this value has no default – Docker will refuse to start without it.
#
# Examples:
#   Linux:  /mnt/storage/music
#   macOS:  /Users/yourusername/Music
#   Windows (WSL2 path): /mnt/c/Users/yourusername/Music
MUSIC_DOWNLOAD_PATH=/path/to/your/music
